# Base URL of the WordPress site to search. Required.
# All content returned by this connector comes from this site's public REST API.
WORDPRESS_URL=https://example.com

# --- Optional settings -------------------------------------------------

# Port to listen on. If set, alj starts the Streamable HTTP
# transport (used for remote deployments like Railway). If unset, it starts
# the stdio transport instead (used by local clients like Claude Desktop).
# Railway sets this automatically — you normally don't need to set it locally.
# PORT=3000

# Timeout for requests to the WordPress REST API, in milliseconds.
# WORDPRESS_TIMEOUT_MS=10000

# Default number of results for search_content / list_recent_content when
# the caller doesn't specify a limit.
# DEFAULT_SEARCH_LIMIT=10

# Upper bound on the limit callers may request.
# MAX_SEARCH_LIMIT=50

# Log verbosity: fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info
